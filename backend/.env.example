# Database Configuration (lokal development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tabungan_rt04
DB_USER=postgres
DB_PASSWORD=your_password

# Database Configuration (production - gunakan salah satu)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# API Configuration
API_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Production CORS (ganti dengan domain frontend kamu)
# CORS_ORIGIN=https://tabrt04.vercel.app,https://tabrt04-frontend.vercel.app

# Logging
LOG_LEVEL=debug
